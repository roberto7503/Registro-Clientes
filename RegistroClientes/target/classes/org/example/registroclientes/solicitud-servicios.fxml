<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.registroclientes.controller.SolicitudServicioController">
    <children>
        <Label layoutX="191.0" layoutY="19.0" text="Solicitud de Servicio">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="80.0" text="Cliente:" />
        <TextField fx:id="txtCliente" layoutX="180.0" layoutY="76.0" prefWidth="300.0" promptText="Nombre del cliente" />

        <Label layoutX="30.0" layoutY="120.0" text="Correo del cliente:" />
        <TextField fx:id="txtCorreo" layoutX="180.0" layoutY="116.0" prefWidth="300.0" promptText="ejemplo@correo.com" />

        <Label layoutX="30.0" layoutY="160.0" text="Tipo de cliente:" />
        <ComboBox fx:id="cmbTipoCliente" layoutX="180.0" layoutY="156.0" prefWidth="300.0" promptText="Seleccione tipo" />

        <Label layoutX="30.0" layoutY="200.0" text="Asunto:" />
        <TextField fx:id="txtAsunto" layoutX="180.0" layoutY="196.0" prefWidth="300.0" promptText="Asunto de la solicitud" />

        <Label layoutX="30.0" layoutY="240.0" text="Tipo de servicio:" />
        <ComboBox fx:id="cmbTipoServicio" layoutX="180.0" layoutY="236.0" prefWidth="300.0" promptText="Seleccione servicio" />

        <Label layoutX="30.0" layoutY="280.0" text="Prioridad:" />
        <fx:define>
            <ToggleGroup fx:id="grupoPrioridad" />
        </fx:define>
        <RadioButton fx:id="rbBaja" layoutX="180.0" layoutY="280.0" mnemonicParsing="false" text="Baja">
         <toggleGroup>
         </toggleGroup></RadioButton>
        <RadioButton fx:id="rbMedia" layoutX="240.0" layoutY="280.0" mnemonicParsing="false" text="Media" toggleGroup="$grupoPrioridad" />
        <RadioButton fx:id="rbAlta" layoutX="315.0" layoutY="280.0" mnemonicParsing="false" text="Alta" toggleGroup="$grupoPrioridad" />

        <Label layoutX="30.0" layoutY="320.0" text="Descripción:" />
        <TextArea fx:id="txtDescripcion" layoutX="180.0" layoutY="320.0" prefHeight="80.0" prefWidth="300.0" promptText="Detalle su problema o solicitud..." />

        <Label layoutX="30.0" layoutY="420.0" text="Archivo adjunto:" />
        <TextField fx:id="txtRutaArchivo" editable="false" layoutX="180.0" layoutY="416.0" prefWidth="210.0" promptText="Ningún carpeta seleccionada" />
        <Button fx:id="btnExaminarArchivo" layoutX="400.0" layoutY="416.0" mnemonicParsing="false" prefWidth="80.0" text="Seleccionar..." />

        <Label layoutX="30.0" layoutY="460.0" text="Carpeta de evidencias:" />
        <TextField fx:id="txtRutaCarpeta" editable="false" layoutX="180.0" layoutY="456.0" prefWidth="210.0" promptText="Ninguna carpeta seleccionada" />
        <Button fx:id="btnExaminarCarpeta" layoutX="400.0" layoutY="456.0" mnemonicParsing="false" prefWidth="80.0" text="Seleccionar..." />

        <Button fx:id="btnGuardar" layoutX="180.0" layoutY="520.0" mnemonicParsing="false" text="Guardar" />
        <Button fx:id="btnCrearSolicitud" layoutX="255.0" layoutY="520.0" mnemonicParsing="false" text="Crear solicitud" />
        <Button fx:id="btnLimpiar" layoutX="365.0" layoutY="520.0" mnemonicParsing="false" text="Limpiar" />
        <Button fx:id="btnCerrar" layoutX="435.0" layoutY="520.0" mnemonicParsing="false" text="Cerrar" />
    </children>
</AnchorPane>
